{
  "name": "standalone-marble-roulette",
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@parcel/config-default": "^2.16.4",
    "@parcel/packager-raw-url": "^2.16.4",
    "@parcel/transformer-sass": "^2.16.4",
    "@parcel/transformer-webmanifest": "^2.16.4",
    "parcel": "^2.16.4",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "lint": "biome check --fix src/",
    "dev": "parcel index.html --port 1235",
    "build": "node scripts/clean-dist.js && parcel build index.html --public-url ./ --no-cache && node scripts/copy-legal.mjs",
    "preview": "node scripts/serve-preview.mjs",
    "test": "node --import ./scripts/register-typescript.mjs --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit --incremental false"
  },
  "dependencies": {
    "@dimforge/rapier2d-compat": "0.20.0",
    "box2d-wasm": "^7.0.0"
  }
}
